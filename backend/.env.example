# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database
# This matches the docker-compose.yml configuration
# Format: postgresql://username:password@host:port/database
# If using docker-compose, these values are already correct!
DATABASE_URL=postgresql://swatch:swatch_dev_password@localhost:5432/safewatch

# Redis Cache/Session Store
# This connects to the Redis container from docker-compose.yml
# If using docker-compose, this value is already correct!
REDIS_URL=redis://localhost:6379

# JWT Authentication
# IMPORTANT: Generate a secure random string for production
# Generate one with: openssl rand -base64 32
# For development, you can use any string, but change it in production!
JWT_SECRET=dev-secret-change-in-production-use-openssl-rand
JWT_EXPIRES_IN=7d

# CORS Settings
# Comma-separated list of allowed origins (your frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000

# Emergency Services Integration (Optional - leave empty for now)
# These will be needed when implementing SMS alerts for emergency services
# Providers like Twilio, AWS SNS, etc.
EMERGENCY_SMS_PROVIDER=
EMERGENCY_API_KEY=
